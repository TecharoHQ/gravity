	resources := &resourcesResourceTables{}
	f.instances.Store(name, resources)
	module, err := f.runtime.InstantiateModule(ctx, f.module, wazero.NewModuleConfig().WithName(name))
	if err != nil {
		f.instances.Delete(name)
		return nil, err
	}
	return &ResourcesInstance{
		module: module,
		resources: resources,
		release: func() { f.instances.Delete(name) },
	}, nil
}

